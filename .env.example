APP_NAME=WS3 Backend API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000

# Local development authentication settings.
# Never reuse these values in production.
AUTH_SECRET_KEY=change-me-before-production
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=false

# Local media storage and optional Tenter realtime relay.
MEDIA_ROOT=media
TENTER_REALTIME_WS_URL=

# Local PostgreSQL used by both backend and Compose.
POSTGRES_DB=ws3
POSTGRES_USER=ws3
POSTGRES_PASSWORD=ws3_password
POSTGRES_PORT=5433
# DATABASE_URL is optional when deliberately using a separate dev database.
