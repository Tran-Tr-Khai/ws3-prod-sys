# Copy to .env in the production deployment directory.
APP_ENV=production
POSTGRES_DB=ws3
POSTGRES_USER=ws3_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Set the HTTPS origin that operators use.
BACKEND_CORS_ORIGINS=https://ws3.example.com
WS3_HTTP_PORT=80
WS3_HTTPS_PORT=443
WS3_TLS_DIR=./infra/tls
API_PREFIX=/api

# Authentication: generate a unique random value before deployment.
AUTH_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Use 0 for a non-expiring session; use 8/12/24 for automatic expiry.
AUTH_SESSION_TTL_HOURS=8
# WebSocket source from the Tenter collector, reachable from the backend container.
# TENTER_REALTIME_WS_URL=ws://host.docker.internal:5001/ws/tenter_data
