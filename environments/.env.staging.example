# Copy to .env in the staging deployment directory.
APP_ENV=staging
POSTGRES_DB=ws3_staging
POSTGRES_USER=ws3_staging
POSTGRES_PASSWORD=REPLACE_WITH_A_STAGING_PASSWORD
BACKEND_CORS_ORIGINS=https://localhost:8443
WS3_HTTP_PORT=8080
WS3_HTTPS_PORT=8443
# Set an absolute path to the staging certificate directory.
WS3_TLS_DIR=./infra/tls
API_PREFIX=/api
AUTH_SECRET_KEY=REPLACE_WITH_A_STAGING_SECRET
AUTH_SESSION_TTL_HOURS=8
