# Runs only on the workstation connected to the industrial camera.
WS3_CAMERA_AGENT_HOST=127.0.0.1
WS3_CAMERA_AGENT_PORT=8765
# Use this only when MVS was installed outside its standard location.
# WS3_MVS_PYTHON_PATH=C:\Program Files (x86)\MVS\Development\Samples\Python\MvImport
# Values validated with the BU-01 MV-CS050-60UC.  Set either to auto to keep
# the camera's automatic exposure/gain setting.
WS3_MVS_EXPOSURE_US=125
WS3_MVS_GAIN_DB=12
# BayerGR8 is the validated BU-01 format. Set to auto for a camera whose
# native format should not be changed.
WS3_MVS_PIXEL_FORMAT=BayerGR8
# Enable only on stations using a CameraLink/CoaXPress/XoF/XoC frame grabber.
# It probes additional MVS transports and can make camera discovery slower.
# WS3_MVS_EXTRA_TRANSPORTS=true
# Comma-separated origins permitted to request the local agent.
WS3_CAMERA_AGENT_ORIGINS=https://192.168.100.253,http://192.168.100.253,https://localhost,https://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
