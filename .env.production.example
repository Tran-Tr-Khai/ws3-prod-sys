# Copy this file to .env.production, then set a unique long password before deployment.
POSTGRES_DB=ws3
POSTGRES_USER=ws3_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# This test machine's current LAN address. Update it if the server IP changes.
BACKEND_CORS_ORIGINS=https://192.168.101.46
WS3_HTTP_PORT=80
WS3_HTTPS_PORT=443
WS3_TLS_DIR=./infra/tls

# Authentication: generate a unique random value before deployment.
AUTH_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Use 0 for a non-expiring session; use 8/12/24 for automatic expiry.
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=true
MEDIA_ROOT=/app/media
